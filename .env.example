# Copiar a .env (no se versiona) y completar. Sin COMPOSE_PROFILES solo se despliega la web estática.

# Dominio público de la web (Traefik)
DOMAIN=dna.codeadevelopment.com

# --- Servidor (D-14): login, empresas, minas e historial ---
# COMPOSE_PROFILES=server
# VITE_API_URL=/api
# POSTGRES_PASSWORD=
# Secreto de sesiones, ≥ 32 caracteres: openssl rand -base64 48
# BETTER_AUTH_SECRET=
# Superadministrador de la plataforma (dueño del software): crea las empresas que pueden usar
# Cronos y las activa o desactiva; no pertenece a ninguna. Se crea al arrancar si no existe; la
# contraseña queda fija y no pide cambiarla (deploy.sh --server usa cronos123).
CRONOS_SUPERADMIN_EMAIL=
# CRONOS_SUPERADMIN_PASSWORD=
# CRONOS_SUPERADMIN_NAME=Administrador de la plataforma
# Cuentas, empresas, minas y proyectos predeterminados, también en producción.
# CRONOS_DEMO_DATA=true

# Asistente de IA (pestaña IA): clave de Google AI Studio. Sin clave, la pestaña avisa.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
