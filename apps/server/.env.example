# Copiar a apps/server/.env para `pnpm dev:server` (PostgreSQL de docker-compose.dev.yml).
DATABASE_URL=postgres://cronos:cronos@localhost:54329/cronos
PORT=3000
LOG_LEVEL=info
BETTER_AUTH_SECRET=dev-secret-only-for-local-development-000
BETTER_AUTH_URL=http://localhost:5173
# Superadministrador de la plataforma (crea las empresas desde /platform)
CRONOS_ADMIN_EMAIL=plataforma@cronos.local
CRONOS_ADMIN_PASSWORD=admin-cronos-dev
