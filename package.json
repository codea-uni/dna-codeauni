{
  "name": "cronos",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @cronos/web dev",
    "dev:server": "pnpm --filter @cronos/server dev",
    "dev:online": "node scripts/dev-online.js",
    "build": "pnpm typecheck && pnpm --filter @cronos/web build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project core --project engine --project workers --project api --project web --project server && vitest run --project perf --project perf-engine",
    "test:watch": "vitest",
    "test:perf": "vitest run --project perf --project perf-engine",
    "test:coverage": "vitest run --project core --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "~3.9.8",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
